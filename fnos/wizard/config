[
  {
    "stepTitle": "夸克自动转存 设置",
    "items": [
      {
        "type": "tips",
        "label": "",
        "helpText": "修改后需要停止再启动应用才会生效。\n\n• WebUI 登录校验：on = 需要登录（admin + 配置里的密码），off = 免登录。\n• 内部更新源：填你自己的仓库（owner/repo）才能收到定制版更新；填上游仓库会把代码更新成上游版本（本地定制会丢失，需在 WebUI 里二次确认）。\n• 端口被占用时保存会失败并提示建议端口。"
      },
      {
        "type": "text",
        "field": "wizard_port",
        "label": "服务端口",
        "initValue": "5005",
        "rules": [
          {
            "required": true,
            "message": "请填写端口"
          },
          {
            "pattern": "^[0-9]+$",
            "message": "端口只能是数字"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_webui_auth",
        "label": "WebUI 登录校验：on = 需要登录，off = 免登录",
        "initValue": "off",
        "rules": [
          {
            "required": true,
            "message": "请填 on 或 off"
          },
          {
            "pattern": "^([oO][nN]|[oO][fF][fF])$",
            "message": "只能填 on（需要登录）或 off（免登录）"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_update_repo",
        "label": "内部更新源（owner/repo）",
        "initValue": "tianlmm/quark-auto-save",
        "rules": [
          {
            "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
            "message": "格式应为 owner/repo"
          }
        ]
      },
      {
        "type": "text",
        "field": "wizard_update_mode",
        "label": "更新通道（auto / release / tag / branch / url）",
        "initValue": "auto",
        "rules": [
          {
            "pattern": "^(auto|release|tag|branch|url)$",
            "message": "只能填 auto、release、tag、branch 或 url"
          }
        ]
      }
    ]
  }
]