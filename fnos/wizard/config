        "field": "wizard_update_mode",
        "label": "更新通道（auto / release / tag / branch / url）",
        "initValue": "auto",
        "rules": [
          { "pattern": "^(auto|release|tag|branch|url)$", "message": "只能填 auto、release、tag、branch 或 url" }
        ]
      }
